<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".TicketAdapter"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardUseCompatPadding="false">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_ticket_card_border"
        android:padding="16dp">

        <!-- Código del Ticket -->
        <TextView
            android:id="@+id/txtTicketCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:text="TCK-2026-0003"
            android:textColor="@color/black"
            android:textSize="12sp" />

        <!-- Insignia / Badge de Estado -->
        <TextView
            android:id="@+id/txtStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/bg_badge_blue"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="Abierto"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Título del Ticket -->
        <TextView
            android:id="@+id/txtTicketTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/txtTicketCode"
            android:layout_marginTop="10dp"
            android:text="Impresora no responde"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Prioridad -->
        <LinearLayout
            android:id="@+id/layoutPriority"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/txtTicketTitle"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgPriorityIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_down_green" />

            <TextView
                android:id="@+id/txtPriorityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Baja"
                android:textColor="@color/black"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Asignación (admin: asignado / sin asignar; técnico: solicitante; usuario: técnico) -->
        <TextView
            android:id="@+id/txtAsignacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/layoutPriority"
            android:layout_marginTop="8dp"
            android:textSize="13sp"
            android:textStyle="bold" />

    </RelativeLayout>
</androidx.cardview.widget.CardView>